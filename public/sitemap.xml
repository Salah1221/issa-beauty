<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static entry points. Product URLs are dynamic (/products/:id); to include them,
  generate this file from the catalog at build/deploy time or serve it from the
  backend (GET /sitemap.xml) so it stays in sync with live products.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://issabeauty.org/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://issabeauty.org/products</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
</urlset>
